# ============================================
# BlindBid Protocol Backend - Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# Network Configuration
# Options: local, testnet, mainnet
NETWORK=testnet

# RPC URLs
LOCAL_RPC_URL=http://127.0.0.1:8545
TESTNET_RPC_URL=https://rpc.ankr.com/monad_testnet
MAINNET_RPC_URL=

# Chain IDs
TESTNET_CHAIN_ID=10143
MAINNET_CHAIN_ID=1990
LOCAL_CHAIN_ID=31337

# Server
PORT=10000

# Smart Contract Addresses
VAULT_AUCTION_ADDRESS=

# Frontend URL (for CORS — set to your deployed frontend)
FRONTEND_URL=https://blindbid-protocol.vercel.app
